#!/usr/bin/env bash
# List the files a book step writes.
#
# The books carry `<!-- bower repo="…" step="…" file="…" -->` markers ahead of
# their fenced blocks. This walks those markers in reading order and answers two
# questions: which steps does a repo have, and which files does a step write.
#
#   bookfiles <repo>          list the steps, in book order
#   bookfiles <repo> <step>   list the files that step writes, in book order
set -euo pipefail

readonly PROG=${0##*/}
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly ROOT
readonly BOOKS=$ROOT/books

usage() {
    cat <<USAGE
usage: $PROG <repo> [step]

  $PROG rust4failures         list the steps in the rust4failures book
  $PROG rust4failures kata    list the files the "kata" step writes

Reads the <!-- bower … --> markers under $BOOKS in chapter order.
USAGE
}

die() {
    printf '%s: %s\n' "$PROG" "$*" >&2
    exit 1
}

# The value of one marker attribute, or the empty string. Attribute values are
# double-quoted and never contain a double quote, so this stays a fixed regex.
attr() {
    local line=$1 key=$2
    if [[ $line =~ $key=\"([^\"]*)\" ]]; then printf '%s' "${BASH_REMATCH[1]}"; fi
}

# The chapters of one book, in reading order. SUMMARY.md is the order mdBook
# itself uses; without one, fall back to sorted names so the answer stays stable.
chapters() {
    local src=$1
    local summary=$src/SUMMARY.md
    local line target
    if [[ -f $summary ]]; then
        while IFS= read -r line; do
            [[ $line =~ \]\(([^\)]+\.md)\) ]] || continue
            target=$src/${BASH_REMATCH[1]}
            if [[ -f $target ]]; then printf '%s\n' "$target"; fi
        done <"$summary"
    else
        find "$src" -maxdepth 1 -name '*.md' ! -name 'SUMMARY.md' | sort
    fi
}

# Every marker for one repo, in reading order, one per line.
markers() {
    local repo=$1 src chapter line
    [[ -d $BOOKS ]] || die "no books directory at $BOOKS"
    for src in "$BOOKS"/*/src; do
        [[ -d $src ]] || continue
        while IFS= read -r chapter; do
            while IFS= read -r line; do
                [[ $line == *'<!-- bower '* ]] || continue
                if [[ $(attr "$line" repo) == "$repo" ]]; then
                    printf '%s\n' "$line"
                fi
            done <"$chapter"
        done < <(chapters "$src")
    done
}

main() {
    case ${1-} in
        -h | --help) usage; return 0 ;;
        '') usage >&2; return 2 ;;
    esac
    (($# <= 2)) || die "expected one or two arguments; got $#"

    local repo=$1 want=${2-} found=0 line step file
    local -a out=()

    while IFS= read -r line; do
        found=1
        step=$(attr "$line" step)
        if [[ -z $want ]]; then
            # Blocks without a step id get an auto-generated one; only explicit
            # ids are addressable, so only those are worth listing.
            if [[ -n $step ]]; then out+=("$step"); fi
        elif [[ $step == "$want" ]]; then
            # A marker without a file writes nothing: op="none", a bare exercise.
            file=$(attr "$line" file)
            if [[ -n $file ]]; then out+=("$file"); fi
        fi
    done < <(markers "$repo")

    ((found)) || die "no book markers for repo \"$repo\""
    ((${#out[@]})) || die "no files for step \"$want\" in repo \"$repo\""

    # First occurrence wins, so the reading order survives the de-duplication.
    printf '%s\n' "${out[@]}" | awk '!seen[$0]++'
}

main "$@"
